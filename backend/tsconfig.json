{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "rootDir": "src",
        "strict": false
    },
    "include": ["src/**/*"]
}